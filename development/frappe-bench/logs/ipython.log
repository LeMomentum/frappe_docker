2026-02-17 14:32:57,785 INFO ipython if not has_lost:
    # Add a "Perdus" stage
    stages.append({
        'name': 'Perdus',
        'color': '#EF4444',
        'probability': 0,
        'status': 'lost',
        'order': len(stages) + 1
    })
    settings.deal_pipeline_stages = json.dumps(stages)
    settings.save(ignore_permissions=True)
    frappe.db.commit()
    print("Added 'Perdus' stage")
