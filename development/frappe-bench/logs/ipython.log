2026-02-01 21:16:26,031 INFO ipython for eid in email_ids:
    status, msg_data = mail.fetch(eid, "(RFC822)")
    for response_part in msg_data:
        if isinstance(response_part, tuple):
            msg = email_lib.message_from_bytes(response_part[1])
            
2026-02-01 21:16:26,032 INFO ipython             subject = decode_header_value(msg.get("Subject", ""))
2026-02-01 21:16:26,033 INFO ipython             sender = decode_header_value(msg.get("From", ""))
2026-02-01 21:16:26,033 INFO ipython             to = decode_header_value(msg.get("To", ""))
2026-02-01 21:16:26,034 INFO ipython             message_id = msg.get("Message-ID", "")
2026-02-01 21:16:26,035 INFO ipython             in_reply_to = msg.get("In-Reply-To", "")
2026-02-01 21:16:26,035 INFO ipython             sender_email = extract_email(sender)
2026-02-01 21:16:26,036 INFO ipython             body = get_email_body(msg)
2026-02-01 21:16:26,037 INFO ipython             # Check existing
2026-02-01 21:16:26,038 INFO ipython             if message_id:
                existing = frappe.db.exists("Communication", {"message_id": message_id})
                if existing:
                    print(f"  Skip: {subject[:40]}")
                    continue
2026-02-01 21:16:26,038 INFO ipython             # Find linked document
