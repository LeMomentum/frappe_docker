2026-01-28 00:28:30,376 INFO ipython import frappe
2026-01-28 00:28:30,377 INFO ipython import csv
2026-01-28 00:28:30,378 INFO ipython import base64
2026-01-28 00:28:30,379 INFO ipython import json
2026-01-28 00:28:30,380 INFO ipython from io import StringIO
2026-01-28 00:28:30,381 INFO ipython from vooroo_saas.api.prospect import _normalize_value, _check_duplicate, _create_or_update_contact, _validate_email
2026-01-28 00:28:30,382 INFO ipython # Lire le fichier
2026-01-28 00:28:30,383 INFO ipython with open('/tmp/test_import.csv', 'rb') as f:
    content = base64.b64decode(base64.b64encode(f.read())).decode('utf-8-sig')
2026-01-28 00:28:30,384 INFO ipython frappe.set_user("Administrator")
2026-01-28 00:28:30,384 INFO ipython # Mapping
2026-01-28 00:28:30,385 INFO ipython mapping = {
    'nom': 'lead_name', 'prenom': 'first_name', 'email': 'email', 
    'telephone': 'mobile_no', 'whatsapp': 'custom_whatsapp',
    'organisation': 'organization', 'type': 'custom_prospect_type', 
    'etiquette': 'custom_lead_label', 'valeur': 'custom_expected_value',
    'profession': 'custom_profession', 'pays': 'custom_residence_country',
    'ville': 'custom_residence_city'
}
2026-01-28 00:28:30,386 INFO ipython # Parser
2026-01-28 00:28:30,386 INFO ipython dialect = csv.Sniffer().sniff(content[:2048], delimiters=',;\t|')
2026-01-28 00:28:30,387 INFO ipython reader = csv.DictReader(StringIO(content), dialect=dialect)
2026-01-28 00:28:30,388 INFO ipython for row_num, row in enumerate(reader, start=2):
    print(f"\n=== Ligne {row_num} ===")
    prospect_data = {
        "doctype": "CRM Lead",
        "lead_owner": "Administrator",
        "status": "New",
        "custom_lead_label": "Froid",
        "custom_prospect_type": "Particulier"
    }
    
2026-01-28 00:28:30,388 INFO ipython     for csv_col, frappe_field in mapping.items():
        if csv_col in row and row[csv_col]:
            value = _normalize_value(frappe_field, row[csv_col])
            if value:
                prospect_data[frappe_field] = value
    
2026-01-28 00:28:30,389 INFO ipython     print(f"Data: {prospect_data}")
2026-01-28 00:28:30,390 INFO ipython     try:
        doc = frappe.get_doc(prospect_data)
        doc.insert(ignore_permissions=True)
        print(f"SUCCESS: {doc.name}")
        _create_or_update_contact(doc)
    except Exception as e:
        print(f"ERROR: {e}")
